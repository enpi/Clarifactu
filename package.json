{
  "name": "clarifactu",
  "version": "1.2.5",
  "description": "Gestión de facturación para profesionales de terapia",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/generate-icon.js",
    "png-to-ico": "electron scripts/png-to-ico.js",
    "build": "electron-builder",
    "publish": "electron-builder --publish always",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test": "jest && playwright test"
  },
  "author": "Clarifactu",
  "build": {
    "appId": "com.clarifactu.app",
    "productName": "Clarifactu",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "enpi",
      "repo": "Clarifactu",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@playwright/**/*",
      "!node_modules/playwright/**/*",
      "!node_modules/playwright-core/**/*",
      "!node_modules/jest*/**/*",
      "!node_modules/@jest/**/*",
      "!node_modules/@babel/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/app-builder-bin/**/*",
      "!node_modules/7zip-bin/**/*",
      "!node_modules/node-gyp/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/better-sqlite3/{src,deps}/**/*",
      "!node_modules/better-sqlite3/prebuilds/{darwin-*,linux-*,linuxmusl-*,win32-arm64}.node"
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.3",
    "nodemailer": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "chart.js": "^4.5.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jest": "^30.5.2"
  },
  "overrides": {
    "jest": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "electron-builder": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
    }
  }
}
